import certificates.Evaluation

/- Generated with the archived relation matrices. All indices used in the
   matrices are zero-based. The identifiers below the definitions retain
   the catalogue's one-based indices. Counting allows non-injective maps. -/
namespace QGI.Certificate

inductive Pattern where
  | tetra | prismTransitive | prismCyclic | nearClique | bipyramid
  deriving DecidableEq, Repr

def Pattern.order : Pattern → Nat
  | .tetra => 4
  | .prismTransitive | .prismCyclic => 6
  | .nearClique => 5
  | .bipyramid => 8

def Pattern.edges : Pattern → List (Nat × Nat)
  | .tetra => [(0,1),(0,2),(0,3),(1,2),(1,3),(2,3)]
  | .prismTransitive => [(0,1),(0,2),(1,2),(3,4),(3,5),(4,5),(0,3),(1,4),(2,5)]
  | .prismCyclic => [(0,1),(1,2),(2,0),(3,4),(4,5),(5,3),(0,3),(1,4),(2,5)]
  | .nearClique => [(0,2),(0,3),(0,4),(1,2),(1,3),(1,4),(2,3),(2,4),(3,4)]
  | .bipyramid => [(3,0),(3,1),(4,0),(4,2),(5,1),(5,2),
      (6,0),(6,2),(6,4),(6,5),(1,6),(3,6),(0,7),(7,1),(7,2),(7,3),(7,4),(7,5)]

structure ColorMatrix where
  order : Nat
  rank : Nat
  entries : Array Nat

def ColorMatrix.get (m : ColorMatrix) (x y : Nat) : Nat :=
  m.entries[x * m.order + y]?.getD m.rank

structure Arc where
  tail : Nat
  head : Nat
  col : Nat

def constraints (p : Pattern) (colors : List Nat) : List (List Arc) :=
  let arcs := p.edges.zipWith (fun edge color => (⟨edge.1, edge.2, color⟩ : Arc)) colors
  (List.range p.order).map fun k => arcs.filter fun e => max e.tail e.head == k

/-- Each level adds the image of one test vertex. Check every arc whose
    larger endpoint is this vertex; a completed assignment contributes one. -/
def countFrom (m : ColorMatrix) : List (List Arc) → Array Nat → Nat
  | [], _ => 1
  | level :: levels, assigned =>
    (List.range m.order).foldl (fun total v =>
      let chosen := assigned.push v
      if level.all (fun e =>
        m.get (chosen[e.tail]?.getD m.order) (chosen[e.head]?.getD m.order) == e.col)
      then total + countFrom m levels chosen else total) 0

def homCount (m : ColorMatrix) (p : Pattern) (colors : List Nat) : Nat :=
  countFrom m (constraints p colors) #[]

def renamed (a : ColorMatrix) (perm colors : List Nat) : List Nat :=
  colors.map fun c => perm[c]?.getD a.rank

def check (a b : ColorMatrix) (p : Pattern) (perm colors : List Nat)
    (sourceCount targetCount : Nat) : Bool :=
  let left := homCount a p colors
  let right := homCount b p (renamed a perm colors)
  if left = right then false else
   a.order == b.order && a.rank == b.rank &&
   a.entries.size == a.order*a.order && b.entries.size == b.order*b.order &&
   a.entries.all (fun c => decide (c < a.rank)) && b.entries.all (fun c => decide (c < b.rank)) &&
   perm.length == a.rank && (List.range a.rank).all (fun c => perm.contains c) &&
   colors.length == p.edges.length && colors.all (fun c => decide (c < a.rank)) &&
   left == sourceCount && right == targetCount

theorem counts_differ_of_checked {a b : ColorMatrix} {p : Pattern}
    {perm colors : List Nat} {s t : Nat}
    (passed : check a b p perm colors s t = true) :
    homCount a p colors ≠ homCount b p (renamed a perm colors) := by
  intro equalCounts
  simp [check, equalCounts] at passed

set_option maxHeartbeats 0
set_option maxRecDepth 100000


