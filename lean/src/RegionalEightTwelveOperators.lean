import RegionalEightTwelveEdges
import RegionalEightTwelveAtoms

noncomputable section
namespace QGI.Coherent.RegionalEightTwelveOperators
open Intertwiner Synchrony StrategyColorLaws SixTenCoordinates RegionalEightTwelveGeometry RegionalEightTwelveStats
open FourTwelveFunctional (source)
open FourTwelveCycle (neighbors)
open private commute_cell from DoubledEdges
open private embed rows from RegionalEightTwelveEdges
open private range from RegionalSixTwelveDispatch

variable {n : Nat} {G H : Graph n} {K : Type} [NormedAddCommGroup K] [InnerProductSpace ℂ K]
    (p : PerfectStrategy G H K)

private theorem row_products (x : Fin n) (s t : Finset (Fin n)) :
    (∑ a∈s, U p x a)*(∑ b∈t, U p x b)=∑ a∈s∩t, U p x a := by
  have inner (a) : ∑ b∈t, U p x a*U p x b=if a∈t then U p x a else 0 := by
    by_cases h : a∈t
    · rw [if_pos h,Finset.sum_eq_single a]
      · exact (restricted_projection p _ _).1
      · intro b _ diff; exact (magic_orthogonal p x a b (Ne.symm diff)).1
      · exact fun out => (out h).elim
    · rw [if_neg h]; apply Finset.sum_eq_zero
      intro b hb; exact (magic_orthogonal p x a b (fun eq => h (eq ▸ hb))).1
  rw [Finset.sum_mul]
  simp only [Finset.mul_sum,inner,←Finset.sum_filter,Finset.filter_mem_eq_inter]

def fan (v : Nat) (a : Fin n) := Finset.univ.filter fun z => targetName p z a=v

private theorem pair_sum {v : Nat} {x i j : Fin n} (ne : i≠j) (shape : neighbors (source G) v x={i,j}) (a : Fin n) :
    U p i a+U p j a=∑ z∈fan p v a, U p x z := by
  apply LinearMap.ext; intro ξ
  have eq := mark_intertwines p v x a ξ
  simp only [mark,ite_smul,one_smul,zero_smul,←Finset.sum_filter] at eq
  change ∑ y∈neighbors (source G) v x, U p y a ξ=∑ z∈fan p v a, U p x z ξ at eq
  rw [shape,Finset.sum_pair ne] at eq
  simpa only [LinearMap.add_apply,LinearMap.sum_apply] using eq

theorem adjacent_commute {v : Nat} {x i j : Fin n} (ne : i≠j) (shape : neighbors (source G) v x={i,j}) (a b : Fin n) :
    Commute (U p i a) (U p j b) := by
  by_cases eq : a=b
  · subst b
    exact (magic_orthogonal p _ _ _ ne).2.trans (magic_orthogonal p _ _ _ (Ne.symm ne)).2.symm
  apply commute_cell (restricted_projection p _ _).1 (magic_orthogonal p a i j ne).2
    (magic_orthogonal p a j i (Ne.symm ne)).2 (magic_orthogonal p i a b eq).1
    (magic_orthogonal p i b a (Ne.symm eq)).1 (magic_orthogonal p j a b eq).1 (magic_orthogonal p j b a (Ne.symm eq)).1
  rw [pair_sum p ne shape a,pair_sum p ne shape b]
  change _*_=_*_
  rw [row_products,row_products,Finset.inter_comm]

private theorem fan_inter {v l r : Nat} (T : Shore (targetName p) l Point) (Z : Shore (targetName p) r Index)
    (wt : ∀ j, (family T Z v j).card=2) (inj : Function.Injective (family T Z v)) {j : Index} {a b : Point}
    (ne : a≠b) (edge : family T Z v j={a,b}) :
    fan p v (atPoint T a) ∩ fan p v (atPoint T b)={atPoint Z j} := by
  have incl (i : Point) (h : i∈({a,b} : Cell)) : targetName p (atPoint Z j) (atPoint T i)=v := by
    rw [←edge] at h
    exact (Finset.mem_filter.mp h).2
  have hasA := incl a (by simp)
  have hasB := incl b (by simp)
  ext z
  simp only [fan,Finset.mem_inter,Finset.mem_filter,Finset.mem_univ,true_and,Finset.mem_singleton]
  constructor
  · rintro ⟨ha,hb⟩
    have diag := (targetLaws p).last ((targetLaws p).rev (ha.trans hasA.symm))
    obtain ⟨k,rfl⟩ := (range Z z).mpr (diag.trans (Z j).property)
    have eq : ({a,b} : Cell)=family T Z v k := Finset.eq_of_subset_of_card_le
      (Finset.insert_subset (Finset.mem_filter.mpr ⟨Finset.mem_univ _,ha⟩)
        (Finset.singleton_subset_iff.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _,hb⟩)))
      (by rw [wt,Finset.card_pair ne])
    exact congrArg (atPoint Z) (inj (eq.symm.trans edge.symm))
  · rintro rfl; exact ⟨hasA,hasB⟩

/-- An edge entry belongs to the algebra generated by the two endpoint rows. -/
theorem edge_commutes {v l r : Nat} (F : Shore (source G) l Point) (Y : Shore (source G) r Index)
    (T : Shore (targetName p) l Point) (Z : Shore (targetName p) r Index)
    (wt : ∀ j, (family T Z v j).card=2) (inj : Function.Injective (family T Z v))
    {j : Index} {i k : Point} (ne : i≠k) (shape : family F Y v j={i,k})
    (M : Module.End ℂ (cyclic p)) (ci : ∀ a, Commute M (U p (atPoint F i) a)) (ck : ∀ a, Commute M (U p (atPoint F k) a))
    (z : Fin n) : Commute M (U p (atPoint Y j) z) := by
  have present : ∃ t a, color F Y t a=v := ⟨j,i,(Finset.mem_filter.mp (show i∈family F Y v j by rw [shape]; simp)).2⟩
  have neigh := rows (sourceLaws _) F Y v present j
  rw [shape,Finset.map_insert,Finset.map_singleton] at neigh
  have diff : atPoint F i≠atPoint F k := (embed F).injective.ne ne
  by_cases h : targetName p z z=r
  · obtain ⟨t,rfl⟩ := (range Z z).mpr h
    obtain ⟨a,b,ab,edge⟩ := Finset.card_eq_two.mp (wt t)
    have inter := fan_inter p T Z wt inj ab edge
    have product : U p (atPoint Y j) (atPoint Z t)=
        (U p (atPoint F i) (atPoint T a)+U p (atPoint F k) (atPoint T a))*
        (U p (atPoint F i) (atPoint T b)+U p (atPoint F k) (atPoint T b)) := by
      rw [pair_sum p diff neigh,pair_sum p diff neigh,row_products,inter,Finset.sum_singleton]
    rw [product]
    exact ((ci _).add_right (ck _)).mul_right ((ci _).add_right (ck _))
  · have zero : U p (atPoint Y j) z=0 := by
      apply LinearMap.ext; intro ξ
      change U p (atPoint Y j) z ξ=0
      by_contra nz
      exact h ((DoubledEdges.diag_of_nonzero p nz).symm.trans (Y j).property)
    rw [zero]; exact Commute.zero_right _

end QGI.Coherent.RegionalEightTwelveOperators

