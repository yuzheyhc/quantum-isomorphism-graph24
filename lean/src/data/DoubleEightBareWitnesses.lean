private def nibble (c : Char) : Nat :=
  if c ≤ '9' then c.toNat - 48 else c.toNat - 87

private def bytesFromHex : List Char → List Nat
  | a :: b :: rest => (16 * nibble a + nibble b) :: bytesFromHex rest
  | _ => []

private def unpack (s : String) : Array Nat := (bytesFromHex s.toList).toArray

def codes : Nat → Array Nat
  | 2 => unpack "80060581040306030202020482"
  | 3 => unpack ""
  | 4 => unpack ""
  | _ => #[]

